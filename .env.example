# Variables de entorno de QATO'K. Copia este archivo a .env (cp .env.example .env).
# Son valores SOLO para desarrollo local: no son credenciales reales. .env nunca se versiona.
#
# Los puertos del host evitan los de instalaciones locales (PostgreSQL 5432, MongoDB 27017,
# Neo4j Desktop 7474/7687). Si alguno choca en tu máquina, cámbialo solo en tu .env.

# ---- API (backend/) ----
NODE_ENV=development
API_PORT=4000
# Origen de la interfaz (Next.js usa el 3000 por defecto), para CORS.
CORS_ORIGEN=http://localhost:3000
# Tiempo máximo para comprobar o conectar con cada base.
DB_TIMEOUT_MS=2000
# Mínimo 32 caracteres. Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- PostgreSQL (relacional) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=qatok
POSTGRES_USER=qatok
POSTGRES_PASSWORD=

# ---- MongoDB (documental) ----
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=qatok
MONGO_USER=qatok
MONGO_PASSWORD=

# ---- Neo4j (grafo) ----
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_USER=neo4j
# Neo4j exige al menos 8 caracteres.
NEO4J_PASSWORD=

# ---- Interfaz (frontend/, Next.js) ----
# Única variable del frontend: la URL de la API. El frontend NO lleva credenciales de bases.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
